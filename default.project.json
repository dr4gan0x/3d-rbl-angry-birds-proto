{
	"name": "flockfall",
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"$className": "ReplicatedStorage",
			"$ignoreUnknownInstances": true,
			"Shared": {
				"$path": "src/shared"
			},
			"Remotes": {
				"$className": "Folder"
			}
		},
		"ServerScriptService": {
			"$className": "ServerScriptService",
			"$ignoreUnknownInstances": true,
			"Server": {
				"$path": "src/server"
			}
		},
		"StarterPlayer": {
			"$className": "StarterPlayer",
			"$ignoreUnknownInstances": true,
			"StarterPlayerScripts": {
				"$className": "StarterPlayerScripts",
				"$ignoreUnknownInstances": true,
				"Client": {
					"$path": "src/client"
				}
			}
		}
	},
	"globIgnorePaths": [
		"**/*.spec.luau",
		"**/testkit/**"
	],
	"emitLegacyScripts": true
}
